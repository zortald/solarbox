# Copy to deploy/local.env (ignored by git) and adjust.
# Router REST API and FTP, as reachable from this machine (directly or through a tunnel).
SB_REST=http://192.168.88.1/rest
SB_FTP_HOST=192.168.88.1
# Optional SOCKS5 proxy for the FTP upload, e.g. 127.0.0.1:1080
SB_SOCKS=
SB_ROUTER_USER=admin
# File with the router password (kept outside the repo)
SB_ROUTER_PW_FILE=~/.solarbox-router-pw
# solarbox itself, for the health check and push-ui/push-config
SB_URL=http://192.168.88.1:8080
