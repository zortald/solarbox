# Cross-compile a static ARMv7 musl binary. RouterOS reports this board's
# architecture as "arm" = 32-bit ARMv7, for which there is no rust:alpine image,
# so we use a purpose-built musl cross toolchain. The builder runs on the native
# build host ($BUILDPLATFORM — no QEMU for the compile); only the tiny final
# image is linux/arm/v7.
#
#   docker buildx build --platform linux/arm/v7 -f deploy/Dockerfile.armv7 -t solarbox:armv7 --load .

FROM --platform=$BUILDPLATFORM messense/rust-musl-cross:armv7-musleabihf AS build
WORKDIR /src
COPY server/ ./
# The image defaults CARGO_BUILD_TARGET to armv7-unknown-linux-musleabihf.
RUN cargo build --release

FROM alpine:3
RUN mkdir -p /data
COPY --from=build /src/target/armv7-unknown-linux-musleabihf/release/solarbox /usr/local/bin/solarbox
ENV SOLARBOX_DB=/data/solarbox.db \
    SOLARBOX_ADDR=0.0.0.0:8080 \
    SOLARBOX_RETENTION_DAYS=0
EXPOSE 8080
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/solarbox"]
